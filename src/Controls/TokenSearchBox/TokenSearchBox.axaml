<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:SourceGit.Controls"
                    xmlns:conv="using:SourceGit.Controls">

  <conv:TokenToColorConverter x:Key="TokenToColorConverter" />
  <conv:TokenToBackgroundConverter x:Key="TokenToBackgroundConverter" />
  <conv:TokenBubblePositionConverter x:Key="TokenBubblePositionConverter" />
  <conv:PlaceholderTextConverter x:Key="PlaceholderTextConverter" />
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

  <DataTemplate x:Key="TokenChipTemplate" x:DataType="c:TokenInstance">
    <Border Name="ChipBorder"
            Height="20"
            CornerRadius="10"
            Margin="0"
            Padding="0"
            BorderThickness="1">
      <Border.Transitions>
        <Transitions>
          <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.1" Easing="SineEaseInOut"/>
          <DoubleTransition Property="Height" Duration="0:0:0.1" Easing="CubicEaseOut"/>
        </Transitions>
      </Border.Transitions>
      <Border.Background>
        <MultiBinding Converter="{StaticResource TokenToBackgroundConverter}">
          <Binding Path="Raw" />
          <Binding Path="$parent[c:TokenSearchBox].PersistentTokens" />
        </MultiBinding>
      </Border.Background>
      <Border.BorderBrush>
        <MultiBinding Converter="{StaticResource TokenToColorConverter}">
          <Binding Path="Raw" />
          <Binding Path="$parent[c:TokenSearchBox].PersistentTokens" />
        </MultiBinding>
      </Border.BorderBrush>
      <Grid ColumnDefinitions="Auto,*">
        <Border Name="LeftBadgeBorder"
                Grid.Column="0"
                Width="20"
                Height="20"
                CornerRadius="10"
                BorderThickness="0"
                Background="Transparent"
                IsVisible="{Binding !IsOperator}"
                Margin="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Border.Styles>
            <Style Selector="ContentPresenter:not(:pointerover):not(.selected) Path#LeftIconPath">
              <Setter Property="Opacity" Value="1.0"/>
            </Style>
            <Style Selector="ContentPresenter:pointerover Path#LeftIconPath">
              <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="ContentPresenter.selected Path#LeftIconPath">
              <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="ContentPresenter:not(:pointerover):not(.selected) Button#PART_DeleteButton">
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
            <Style Selector="ContentPresenter:pointerover Button#PART_DeleteButton">
              <Setter Property="Opacity" Value="1.0"/>
              <Setter Property="IsHitTestVisible" Value="True"/>
            </Style>
            <Style Selector="ContentPresenter.selected Button#PART_DeleteButton">
              <Setter Property="Opacity" Value="1.0"/>
              <Setter Property="IsHitTestVisible" Value="True"/>
            </Style>
          </Border.Styles>
          <Grid>
            <Path Name="LeftIconPath"
                  Data="{Binding Provider.Icon}"
                  Fill="{DynamicResource Brush.FG1}"
                  Width="10"
                  Height="10"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
            <Button Name="PART_DeleteButton"
                    Classes="icon"
                    Focusable="False"
                    Command="{Binding $parent[c:TokenSearchBox].RemoveTokenCommand}"
                    CommandParameter="{Binding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="0"
                    Width="10"
                    Height="10"
                    Background="Transparent"
                    BorderThickness="0">
              <Button.Styles>
                <Style Selector="Button#PART_DeleteButton /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                </Style>
              </Button.Styles>
              <Path Data="{StaticResource Icons.Clear}"
                    Fill="{DynamicResource Brush.FG1}"
                    Stretch="Uniform" />
            </Button>
          </Grid>
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding DisplayText}"
                   FontSize="12"
                   VerticalAlignment="Center">
          <TextBlock.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Margin" Value="6,0,10,0"/>
            </Style>
            <Style Selector="TextBlock[Text=|]">
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Margin" Value="10,0,10,0"/>
            </Style>
            <Style Selector="TextBlock[Text=&amp;]">
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Margin" Value="10,0,10,0"/>
            </Style>
            <Style Selector="TextBlock[Text=||]">
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Margin" Value="10,0,10,0"/>
            </Style>
            <Style Selector="TextBlock[Text=&amp;&amp;]">
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Margin" Value="10,0,10,0"/>
            </Style>
            <Style Selector="TextBlock[Text=(]">
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Margin" Value="10,0,10,0"/>
            </Style>
            <Style Selector="TextBlock[Text=)]">
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Margin" Value="10,0,10,0"/>
            </Style>
          </TextBlock.Styles>
        </TextBlock>
      </Grid>
    </Border>
  </DataTemplate>

  <Design.PreviewWith>
    <Border Padding="20">
      <c:TokenSearchBox Width="400" PlaceholderText="Search..."/>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type c:TokenSearchBox}" TargetType="c:TokenSearchBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Contents}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_RootBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="*,Auto">
            <!-- Tokens and TextBox Container -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Margin="8,0"
                          MaxHeight="{TemplateBinding MaxListHeight}">

              <Grid>
                <!-- Combined Icon + Placeholder Layer -->
                <!-- Only visible when text is empty AND no tokens are present -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0"
                            IsHitTestVisible="False"
                            Spacing="8">
                  <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static conv:LogicConverters.And}">
                      <Binding Path="Text" ElementName="PART_TextPresenter" Converter="{x:Static conv:LogicConverters.IsNullOrEmpty}"/>
                      <Binding Path="SelectedTokens.Count" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static conv:LogicConverters.IsZero}"/>
                    </MultiBinding>
                  </StackPanel.IsVisible>
                  <Path Width="14" Height="14"
                        Data="{StaticResource Icons.Search}"
                        Fill="{DynamicResource Brush.FG2}"
                        Stretch="Uniform"
                        VerticalAlignment="Center"/>
                  <TextBlock Text="{TemplateBinding PlaceholderText}"
                             Foreground="{DynamicResource Brush.FG2}"
                             FontSize="14"
                             VerticalAlignment="Center"/>
                </StackPanel>

                    <WrapPanel Name="PART_TokensList"
                               Orientation="Horizontal"
                               VerticalAlignment="Center"
                               MinHeight="32">
                      <WrapPanel.Styles>
                        <!-- Base ContentPresenter style representing the item -->
                        <Style Selector="ContentPresenter" x:DataType="c:TokenInstance">
                          <Setter Property="VerticalAlignment" Value="Center"/>
                          <Setter Property="Padding" Value="0,0,6,0"/>
                          <Setter Property="Margin" Value="0,3,2,3"/>
                          <Setter Property="CornerRadius" Value="12"/>
                          <Setter Property="Focusable" Value="False"/>
                          <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Start]">
                          <Setter Property="Padding" Value="0"/>
                          <Setter Property="Margin" Value="0,3,0,3"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Middle]">
                          <Setter Property="Padding" Value="0"/>
                          <Setter Property="Margin" Value="-1,3,0,3"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Operator]">
                          <Setter Property="Padding" Value="0"/>
                          <Setter Property="Margin" Value="-1,3,0,3"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=End]">
                          <Setter Property="Margin" Value="-1,3,2,3"/>
                        </Style>

                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Start] Border#ChipBorder">
                          <Setter Property="CornerRadius" Value="10,0,0,10"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Middle] Border#ChipBorder">
                          <Setter Property="CornerRadius" Value="0"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Operator] Border#ChipBorder">
                          <Setter Property="CornerRadius" Value="0"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=End] Border#ChipBorder">
                          <Setter Property="CornerRadius" Value="0,10,10,0"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Middle] Border#LeftBadgeBorder">
                          <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=End] Border#LeftBadgeBorder">
                          <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Middle] TextBlock">
                          <Setter Property="Margin" Value="13,0,10,0"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=End] TextBlock">
                          <Setter Property="Margin" Value="13,0,10,0"/>
                        </Style>
                        <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ContentPresenter[Tag=Operator] TextBlock">
                          <Setter Property="Margin" Value="17,0,10,0"/>
                        </Style>

                        <Style Selector="c|TokenSearchBox:focus-within ContentPresenter.selected Border#ChipBorder">
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.FG1}"/>
                          <Setter Property="Height" Value="24"/>
                        </Style>

                        <Style Selector="ContentPresenter:pointerover Border#ChipBorder">
                          <Setter Property="Height" Value="24"/>
                        </Style>
                      </WrapPanel.Styles>

                      <!-- Real Input TextBox (last child; token chips are inserted before it programmatically) -->
                      <TextBox Name="PART_TextPresenter"
                               Text="{Binding $parent[c:TokenSearchBox].Text, Mode=TwoWay}"
                               Background="Transparent"
                               BorderThickness="0"
                               Padding="4,0"
                               MinHeight="30"
                               MinWidth="120"
                               VerticalContentAlignment="Center"
                               FontSize="14">
                        <TextBox.Styles>
                          <!-- Ensure background and border are always transparent to fit inside the TokenSearchBox -->
                          <Style Selector="TextBox /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                          </Style>
                          <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                          </Style>
                          <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                          </Style>
                        </TextBox.Styles>
                      </TextBox>
                    </WrapPanel>
              </Grid>
            </ScrollViewer>

            <!-- Clear Button -->
            <Button Name="PART_ClearButton"
                    Grid.Column="1"
                    Classes="icon_button"
                    Width="26" Height="26"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center">
              <Path Width="10" Height="10" Data="{StaticResource Icons.Clear}" Fill="{DynamicResource Brush.FG2}"/>
            </Button>

            <!-- Suggestions Popup -->
            <Popup Name="PART_SuggestionsPopup"
                   PlacementTarget="{Binding #PART_RootBorder}"
                   Placement="Bottom"
                   IsLightDismissEnabled="True"
                   Width="{Binding #PART_RootBorder.Bounds.Width}"
                   MaxHeight="400">
              <Border Background="{DynamicResource Brush.Popup}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="4"
                      Effect="drop-shadow(0 0 12 #40000000)">
                <Grid RowDefinitions="*,Auto">
                  <ListBox Name="PART_SuggestionsList"
                           Grid.Row="0"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="MinHeight" Value="24"/>
                        <Setter Property="CornerRadius" Value="4"/>
                      </Style>
                      <Style Selector="ListBoxItem Button#PART_SuggestionActionButton">
                        <Setter Property="IsVisible" Value="True"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="11"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover Button#PART_SuggestionActionButton">
                        <Setter Property="Background" Value="{DynamicResource Brush.Badge}"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected Button#PART_SuggestionActionButton">
                        <Setter Property="Background" Value="{DynamicResource Brush.Badge}"/>
                      </Style>
                      <Style Selector="Button#PART_SuggestionActionButton:focus">
                        <Setter Property="Background" Value="{DynamicResource Brush.Badge}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.DataTemplates>
                      <DataTemplate DataType="c:TokenSuggestionHeader">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Margin="0,8,0,2" />
                      </DataTemplate>
                      <DataTemplate DataType="c:TokenSuggestion">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <Path Grid.Column="0"
                                Data="{Binding Icon}"
                                Width="10" Height="10"
                                Fill="{DynamicResource Brush.FG2}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                          <Button Grid.Column="3"
                                  Name="PART_SuggestionActionButton"
                                  Command="{Binding $parent[c:TokenSearchBox].SuggestionActionCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding ActionTooltip}"
                                  Width="22"
                                  Height="22"
                                  Padding="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                            <Path Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource Brush.FG2}"
                                  Data="{Binding ActionIcon}"/>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.DataTemplates>
                  </ListBox>

                  <ContentControl Name="PART_CustomEditorPresenter"
                                  Grid.Row="1"
                                  BorderThickness="0,1,0,0"
                                  BorderBrush="{DynamicResource Brush.Border2}"
                                  IsVisible="False" />
                </Grid>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- State Styles -->
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}" />
    </Style>
    <Style Selector="^:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
