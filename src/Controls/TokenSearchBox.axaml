<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:SourceGit.Controls"
                    xmlns:conv="using:SourceGit.Converters">
  <conv:TokenToColorConverter x:Key="TokenToColorConverter" />
  <conv:TokenToBackgroundConverter x:Key="TokenToBackgroundConverter" />
  <conv:TokenBubblePositionConverter x:Key="TokenBubblePositionConverter" />

  <Design.PreviewWith>
    <Border Padding="20">
      <c:TokenSearchBox Width="400" Watermark="Search or type filter..." />
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type c:TokenSearchBox}" TargetType="c:TokenSearchBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Contents}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_RootBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0"
                          MaxHeight="{TemplateBinding MaxListHeight}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <WrapPanel VerticalAlignment="Center">
                <!-- Tokens (Chips) -->
                <ListBox Name="PART_TokensList"
                         ItemsSource="{TemplateBinding SelectedTokens}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.Styles>
                    <!-- Base ListBoxItem style -->
                    <Style Selector="ListBoxItem" x:DataType="x:String">
                      <Setter Property="Tag">
                        <MultiBinding Converter="{StaticResource TokenBubblePositionConverter}">
                          <Binding />
                          <Binding Path="$parent[c:TokenSearchBox].SelectedTokens" />
                          <Binding Path="$parent[c:TokenSearchBox].SelectedTokens.Count" />
                        </MultiBinding>
                      </Setter>
                      <Setter Property="Padding" Value="0,0,6,0"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="CornerRadius" Value="12"/>
                      <Setter Property="FocusAdorner" Value="{x:Null}"/>
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>

                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>

                    <!-- Bubble Merging - Flat Selectors to prevent NestingSelector crash -->
                    <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ListBoxItem[Tag=Start]">
                      <Setter Property="Padding" Value="0"/>
                    </Style>
                    <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ListBoxItem[Tag=Middle]">
                      <Setter Property="Padding" Value="0"/>
                    </Style>
                    <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ListBoxItem[Tag=Operator]">
                      <Setter Property="Padding" Value="0"/>
                    </Style>

                    <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ListBoxItem[Tag=Start] Border#ChipBorder">
                      <Setter Property="CornerRadius" Value="12,0,0,12"/>
                      <Setter Property="Padding" Value="12,0,18,0"/>
                    </Style>
                    <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ListBoxItem[Tag=Middle] Border#ChipBorder">
                      <Setter Property="CornerRadius" Value="0"/>
                      <Setter Property="Padding" Value="13,0,18,0"/>
                      <Setter Property="BorderThickness" Value="0,1,1,1"/>
                    </Style>
                    <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ListBoxItem[Tag=Operator] Border#ChipBorder">
                      <Setter Property="CornerRadius" Value="0"/>
                      <Setter Property="Padding" Value="13,0,18,0"/>
                      <Setter Property="BorderThickness" Value="0,1,1,1"/>
                    </Style>
                    <Style Selector="c|TokenSearchBox:not(:pointerover):not(:focus-within) ListBoxItem[Tag=End] Border#ChipBorder">
                      <Setter Property="CornerRadius" Value="0,12,12,0"/>
                      <Setter Property="Padding" Value="13,0,12,0"/>
                      <Setter Property="BorderThickness" Value="0,1,1,1"/>
                    </Style>

                    <!-- Selection & Hover for Delete Button -->
                    <Style Selector="c|TokenSearchBox:focus-within ListBoxItem:selected Border#ChipBorder">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FG1}"/>
                      <Setter Property="Height" Value="24"/>
                    </Style>

                    <!-- Hover 时气泡变高 -->
                    <Style Selector="ListBoxItem:pointerover Border#ChipBorder">
                      <Setter Property="Height" Value="24"/>
                    </Style>
                  </ListBox.Styles>

                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Name="ChipBorder"
                              CornerRadius="12"
                              Height="20"
                              Margin="0"
                              Padding="12,0,12,0"
                              BorderThickness="1">
                        <Border.Background>
                          <MultiBinding Converter="{StaticResource TokenToBackgroundConverter}">
                            <Binding />
                            <Binding Path="$parent[c:TokenSearchBox].PersistentTokens" />
                          </MultiBinding>
                        </Border.Background>
                        <Border.BorderBrush>
                          <MultiBinding Converter="{StaticResource TokenToColorConverter}">
                            <Binding />
                            <Binding Path="$parent[c:TokenSearchBox].PersistentTokens" />
                          </MultiBinding>
                        </Border.BorderBrush>
                        <Grid>
                          <TextBlock Text="{Binding}"
                                     FontSize="12"
                                     VerticalAlignment="Center">
                            <TextBlock.Styles>
                              <Style Selector="TextBlock[Text=|]">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Opacity" Value="0.5"/>
                              </Style>
                              <Style Selector="TextBlock[Text=||]">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Opacity" Value="0.5"/>
                              </Style>
                              <Style Selector="TextBlock[Text=&amp;&amp;]">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Opacity" Value="0.5"/>
                              </Style>
                            </TextBlock.Styles>
                          </TextBlock>

                          <Button Name="PART_DeleteButton"
                                  Classes="icon"
                                  Command="{Binding $parent[c:TokenSearchBox].RemoveToken}"
                                  CommandParameter="{Binding}"
                                  IsVisible="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,-2,0"
                                  Padding="0"
                                  Width="10" Height="10"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <Button.Styles>
                              <!-- Always transparent background -->
                              <Style Selector="Button#PART_DeleteButton /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                              </Style>
                              <!-- Show on hover or selected -->
                              <Style Selector="ListBoxItem:pointerover Button#PART_DeleteButton">
                                <Setter Property="IsVisible" Value="True"/>
                              </Style>
                              <Style Selector="ListBoxItem:selected Button#PART_DeleteButton">
                                <Setter Property="IsVisible" Value="True"/>
                              </Style>
                              <Style Selector="Button[CommandParameter=|]">
                                <Setter Property="IsVisible" Value="False"/>
                              </Style>
                              <Style Selector="Button[CommandParameter=&amp;]">
                                <Setter Property="IsVisible" Value="False"/>
                              </Style>
                              <Style Selector="Button[CommandParameter=||]">
                                <Setter Property="IsVisible" Value="False"/>
                              </Style>
                              <Style Selector="Button[CommandParameter=&amp;&amp;]">
                                <Setter Property="IsVisible" Value="False"/>
                              </Style>
                            </Button.Styles>
                            <Path Data="M 0 0 L 8 8 M 0 8 L 8 0"
                                  Stroke="{DynamicResource Brush.FG1}"
                                  StrokeThickness="1.5"
                                  Width="8"
                                  Height="8"
                                  VerticalAlignment="Center" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- Input TextBox -->
                <TextBox Name="PART_TextPresenter"
                         Text="{TemplateBinding Text, Mode=TwoWay}"
                         PlaceholderText="{TemplateBinding Watermark}"
                         BorderThickness="0"
                         Background="Transparent"
                         MinWidth="120"
                         Margin="0"
                         Padding="4,4"
                         VerticalAlignment="Center"
                         Theme="{StaticResource {x:Type TextBox}}">
                  <TextBox.Styles>
                    <Style Selector="TextBox /template/ Border#PART_BorderElement">
                      <Setter Property="IsVisible" Value="False" />
                    </Style>
                  </TextBox.Styles>
                </TextBox>
              </WrapPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" VerticalAlignment="Center">
              <Path Name="PART_SearchIcon"
                    Data="{StaticResource Icons.Search}"
                    Width="14" Height="14"
                    Fill="{DynamicResource Brush.FG2}"
                    Margin="8,0"
                    VerticalAlignment="Center"/>

              <Button Name="PART_ClearButton"
                      Width="16" Height="16"
                      CornerRadius="8"
                      Padding="0"
                      Margin="7,0"
                      Background="{DynamicResource Brush.FG2}"
                      BorderThickness="0"
                      IsVisible="False"
                      VerticalAlignment="Center"
                      Cursor="Hand"
                      Opacity="0.8">
                <Path Data="M 4,4 L 12,12 M 4,12 L 12,4"
                      Stroke="White"
                      StrokeThickness="1.5"
                      Width="8" Height="8"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"/>
              </Button>
            </Grid>

            <Popup Name="PART_SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=PART_TextPresenter}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   IsOpen="False">
              <Border Background="{DynamicResource Brush.Popup}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="2"
                      Margin="0,4,0,0"
                      MinWidth="200"
                      MaxHeight="260"
                      Effect="drop-shadow(0 0 8 #40000000)">
                <ListBox Name="PART_SuggestionsList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="8,4"/>
                      <Setter Property="MinHeight" Value="24"/>
                      <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBox.DataTemplates>
                    <DataTemplate DataType="c:TokenSuggestionHeader">
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 FontWeight="Bold"
                                 FontSize="11"
                                 Margin="0,8,0,2" />
                    </DataTemplate>
                    <DataTemplate DataType="c:TokenSuggestion">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Path Grid.Column="0"
                              Data="{Binding Icon}"
                              Width="10" Height="10"
                              Fill="{DynamicResource Brush.FG2}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.DataTemplates>
                </ListBox>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}" />
    </Style>
    <Style Selector="^:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
